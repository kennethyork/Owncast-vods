# Copy to .env and edit:  cp .env.example .env

# ---- Owncast ---------------------------------------------------------------
# Where the recorder can reach Owncast. Same machine: http://127.0.0.1:<port>.
# Another machine: its public URL, e.g. https://stream.example.com
OWNCAST_URL=http://127.0.0.1:8080

# Record one quality instead of the best one, e.g. /hls/0/stream.m3u8
# HLS_PATH=/hls/stream.m3u8

# ---- Recording -------------------------------------------------------------
# VOD length in seconds: 3600 = 1h, 7200 = 2h, 14400 = 4h, 21600 = 6h
SEGMENT_SECONDS=14400

# Time zone for split times (files split on the clock, e.g. 00:00/04:00/08:00...)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Folder on this machine where VOD files are saved
VOD_PATH=./vods

# Delete local VODs older than this many days (0 = keep forever)
RETENTION_DAYS=14

# Delete the oldest local VODs if free disk space drops below this (GB)
MIN_FREE_GB=5

# ---- VOD page --------------------------------------------------------------
# Heading on the /vods page
TITLE=Stream VODs

# Your stream page ("/" = same domain as the page); default for NOTIFY_URL
LIVE_URL=/

# Port the page listens on. BIND=127.0.0.1 means only a reverse proxy on this
# machine can reach it; use 0.0.0.0 to open it directly (not recommended).
PORT=8090
BIND=127.0.0.1

# Secret for the Owncast webhook URL (?token=...). Change this!
# Generate one with:  openssl rand -hex 16
WEBHOOK_TOKEN=change-me-to-something-random

# Password required to download VODs (for uploading to YouTube etc.).
# Generate one with:  openssl rand -hex 20
# Leave empty to allow downloads without a password.
# Viewers can still watch on the /vods page without a password; the player
# gets links that expire after 12 hours instead of permanent file URLs.
ADMIN_PASSWORD=

# ---- Thumbnails (optional) --------------------------------------------------
# Set to 0 to disable thumbnail generation entirely.
THUMB_ENABLED=1

# Offset in seconds into the VOD to grab the thumbnail frame (default: 60s).
THUMB_OFFSET=60

# ---- Email notifications (optional) -----------------------------------------
# When a VOD finishes, the recorder sends an email so you know it's ready to
# download for YouTube. Leave SMTP_HOST empty to disable email.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com and an
# App Password (https://myaccount.google.com/apppasswords) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address (defaults to SMTP_USER if blank)
SMTP_FROM=
# Comma-separated list of recipient addresses
NOTIFY_TO=
# Full public URL of your site; the email links to <NOTIFY_URL>/vods
# NOTIFY_URL=https://stream.example.com

# ---- Comments ----------------------------------------------------------------
# Viewers comment under VODs as their Owncast chat name (needs /vods on the
# same domain as Owncast). Posting is only open while the stream is offline.
# 0 = turn comments off.
COMMENTS=1

# ---- Cloud backup (optional) -------------------------------------------------
# Uncomment to turn on the backup container (see README -> Cloud backup):
# COMPOSE_PROFILES=backup

# Name of the rclone remote you create (dropbox, gdrive, s3, b2, ...)
BACKUP_REMOTE=dropbox

# Port the backup container's WebDAV server listens on (local only).
# The recorder uses CLOUD_URL to list and stream cloud-stored VODs on the page.
# Uncomment CLOUD_URL only once the backup container is running.
CLOUD_PORT=8091
# CLOUD_URL=http://127.0.0.1:8091

# Folder (or bucket/folder) on the remote
BACKUP_FOLDER=Owncast VODs

# How often to upload finished VODs (minutes)
BACKUP_INTERVAL_MIN=15

# Delete VODs from the remote after this many days (0 = keep forever)
BACKUP_RETENTION_DAYS=0
