# Copy to .env and edit:  cp .env.example .env

# Where Owncast answers on this server (same as CloudPanel's Reverse Proxy URL)
OWNCAST_URL=http://127.0.0.1:8080

# Secret for the Owncast webhook URL (?token=...). Change this!
WEBHOOK_TOKEN=change-me-to-something-random

# VOD length in seconds (14400 = 4 hours)
SEGMENT_SECONDS=14400

# Time zone for split times (12am/4am/8am/12pm/4pm/8pm)
TZ=America/New_York

# Delete VODs older than this many days (0 = keep forever)
RETENTION_DAYS=14

# Delete oldest VODs if free disk space drops below this (GB)
MIN_FREE_GB=5

# Heading on the /vods page
TITLE=Stream VODs

# Port the page listens on (127.0.0.1 only)
PORT=8090

# Folder on the VPS where VOD files are saved
VOD_PATH=./vods

# Record a single quality instead of the best one, e.g. /hls/0/stream.m3u8
# HLS_PATH=/hls/stream.m3u8
